# Demo/Docker needs no .env file. These are optional local-mode settings.
APP_PORT=8501
INTERVIEWTRACK_DATA_DIR=./data
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
GMAIL_LOOKBACK_DAYS=92
GMAIL_MAX_MESSAGES=200
GMAIL_PAGE_SIZE=100
# Desktop OAuth only: use a Desktop app credential, not a Web app credential.
# GOOGLE_CLIENT_SECRET_FILE=./data/client_secret.json
# GOOGLE_TOKENS_DIR=./data/tokens
# GMAIL_EXPECTED_ACCOUNT=you@gmail.com
LLM_REVIEW_ENABLED=false
